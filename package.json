{
  "name": "free-ai-note-taker",
  "productName": "Free AI Note Taker",
  "version": "0.5.1",
  "description": "Grava reuniões (Teams, Meet, Zoom), transcreve localmente ou na nuvem e gera resumo com IA.",
  "author": "Lucas Duarte",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "dev.lucasduarte.free-ai-note-taker",
    "files": [
      "src/**/*"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Free-AI-Note-Taker-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Gravar o áudio da reunião."
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lucasdu4rte",
        "repo": "free-ai-note-taker"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "electron-updater": "^6.8.11",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@45.0.0": true
  },
  "license": "MIT"
}
